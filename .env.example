# Required: Free Google AI Studio API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Free Groq API Key (https://console.groq.com/keys) used automatically if Gemini fails/rate-limits or is omitted
# GROQ_API_KEY=your_groq_api_key_here

# Optional: Override primary Gemini model (defaults to gemini-4-hydrogen with automatic fallback)
# GEMINI_MODEL=gemini-4-hydrogen
