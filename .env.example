# Primary: Free Google AI Studio API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended Fallback (Paid or Free Credits, no strict ITPM limits): OpenRouter API Key (https://openrouter.ai/keys)
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional Secondary Fallback: Free Groq API Key (https://console.groq.com/keys)
# GROQ_API_KEY=your_groq_api_key_here

# Optional: Set LLM_PROVIDER=openrouter to route directly through OpenRouter first
# LLM_PROVIDER=openrouter

# Optional: Override primary Gemini model (defaults to gemini-3.1-flash-lite with automatic fallback)
# GEMINI_MODEL=gemini-3.1-flash-lite
